+TaskExtrudeParameters::TaskExtrudeParameters(
+    ViewProviderExtrude* SketchBasedView,
+    QWidget* parent,
+    const std::string& pixmapname,
+    const QString& parname
+)
+    : TaskSketchBasedParameters(SketchBasedView, parent, pixmapname, parname)
