+    std::string    m_saveScaleType;
+    double         m_saveScale{1};
+    bool           m_saveAutoDistribute{false};
+    double         m_saveSpacingX{15};
+    double         m_saveSpacingY{15};
+    Base::Vector3d m_saveDirection;
+    std::vector<std::string> m_saveViewNames;
+};
