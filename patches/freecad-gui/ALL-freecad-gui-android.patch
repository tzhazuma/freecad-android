+bool Command::isViewOfType(Base::Type t) const
+{
+    Gui::Document* d = getGuiApplication()->activeDocument();
+    if (!d) {
+        return false;
+    }
+    Gui::BaseView* v = d->getActiveView();
+    if (!v) {
+        return false;
+    }
+    if (v->isDerivedFrom(t)) {
+        return true;
+    }
+    else {
+        return false;
+    }
+}
