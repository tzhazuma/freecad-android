+    PyGILStateLocker locker;
+    module = PP_Load_Module("__main__"); /* get module, init python */
+    if (!module) {
+        throw PyException(); /* not incref'd */
+    }
+    dict = PyModule_GetDict(module); /* get dict namespace */
+    if (!dict) {
+        throw PyException(); /* not incref'd */
