+MenuItem& MenuItem::operator<<(const std::string& command)
+{
+    auto item = new MenuItem(this);
+    item->setCommand(command);
+    return *this;
+}
+
+MenuItem& MenuItem::operator<<(MenuItem* item)
+{
+    appendItem(item);
+    return *this;
+}
