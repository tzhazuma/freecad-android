diff --git a/cMake/FreeCAD_Helpers/SetupQt.cmake b/cMake/FreeCAD_Helpers/SetupQt.cmake
index f536efb..23a9159 100644
--- a/cMake/FreeCAD_Helpers/SetupQt.cmake
+++ b/cMake/FreeCAD_Helpers/SetupQt.cmake
@@ -1,6 +1,20 @@
 # -------------------------------- Qt --------------------------------
 
 set(FREECAD_QT_COMPONENTS Core Concurrent Network Xml)
+# Android-port note: src/App/CMakeLists.txt calls qt_add_translation() unconditionally,
+# but qt_add_translation is defined by Qt6LinguistTools, which upstream only pulls in when
+# BUILD_GUI=ON. A headless (BUILD_GUI=OFF) configure therefore dies with
+#   Unknown CMake command "qt_add_translation"
+# LinguistTools is a HOST tool package, so it resolves through QT_HOST_PATH even when the
+# target is Android. Request it unconditionally.
+list(APPEND FREECAD_QT_COMPONENTS LinguistTools)
+# Android-port note: TechDraw's App/CMakeLists.txt reads ${QtGui_INCLUDE_DIR} and
+# ${QtCore_INCLUDE_DIR} and links ${QtWidgets_LIBRARIES}. With BUILD_GUI=OFF neither
+# Gui nor Widgets was ever requested, so those variables were empty and TechDraw died
+# with "fatal error: 'QColor' file not found". Requesting the two components here only
+# provides their headers and targets; it does not enable any GUI build target
+# (src/Gui and Mod/*/Gui stay gated behind BUILD_GUI).
+list(APPEND FREECAD_QT_COMPONENTS Gui Widgets)
 set(Qt6Core_MOC_EXECUTABLE Qt6::moc)
 
 if(BUILD_GUI)
@@ -35,6 +49,14 @@ foreach(COMPONENT IN LISTS FREECAD_QT_COMPONENTS)
     set(Qt${COMPONENT}_VERSION ${Qt${FREECAD_QT_MAJOR_VERSION}${COMPONENT}_VERSION})
 endforeach()
 
+# The loop above only defines the plural *_INCLUDE_DIRS forms. TechDraw's
+# App/CMakeLists.txt uses the singular QtCore_INCLUDE_DIR / QtGui_INCLUDE_DIR, which
+# nothing else in the tree sets. Alias them so a BUILD_GUI=OFF configure can still
+# compile TechDraw.
+set(QtCore_INCLUDE_DIR "${QtCore_INCLUDE_DIRS}")
+set(QtGui_INCLUDE_DIR "${QtGui_INCLUDE_DIRS}")
+set(QtWidgets_INCLUDE_DIR "${QtWidgets_INCLUDE_DIRS}")
+
 if(Qt${FREECAD_QT_MAJOR_VERSION}Core_VERSION VERSION_LESS 5.13.0)
     message(FATAL_ERROR [[
      ******************************************************************
