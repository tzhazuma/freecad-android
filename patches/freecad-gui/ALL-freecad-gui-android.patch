diff --git a/src/App/ApplicationDirectories.cpp b/src/App/ApplicationDirectories.cpp
index ed101df..5a245c0 100644
--- a/src/App/ApplicationDirectories.cpp
+++ b/src/App/ApplicationDirectories.cpp
@@ -695,6 +695,39 @@ fs::path ApplicationDirectories::findHomePath(const char* sCall)
     return Base::FileInfo::stringToPath(homePath);
 }
 
+#elif defined(__ANDROID__)
+// The headers above sit inside the __OpenBSD__ arm of this chain, so include what this
+// branch needs itself.
+#include <cstdlib>
+#include <filesystem>
+#include <Base/FileInfo.h>
+
+fs::path ApplicationDirectories::findHomePath(const char* sCall)
+{
+    // Android-port: the install-prefix model does not exist here. Qt's loader calls
+    // main() in a shared object, so argv[0] is not a filesystem path, and
+    // /proc/self/exe points at the zygote's app_process. The Linux logic below would
+    // derive "/system" from that, making the resource directory "/system/share" --
+    // a path that cannot exist in an APK install. FreeCAD then fails to find every
+    // workbench icon:
+    //   Cannot find icon: /system/share/Mod/Part/Resources/icons/PartWorkbench.svg
+    //
+    // The native bridge exports FREECAD_ANDROID_HOME pointing at the app's private
+    // data directory, where MainActivity unpacks Mod/ (and a "share" alias that makes
+    // <home>/share/Mod resolve to it).
+    if (const char* androidHome = ::getenv("FREECAD_ANDROID_HOME")) {
+        if (*androidHome) {
+            fs::path path = Base::FileInfo::stringToPath(androidHome);
+            if (!path.empty() && path.string().back() != '/') {
+                path += "/";
+            }
+            return path;
+        }
+    }
+    (void)sCall;
+    return Base::FileInfo::stringToPath("/data/data/org.freecad.android/files/");
+}
+
 #elif defined (FC_OS_LINUX) || defined(FC_OS_CYGWIN) || defined(FC_OS_BSD)
 #include <cstdio>
 #include <cstdlib>
