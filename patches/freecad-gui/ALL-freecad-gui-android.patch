+
+public:
+    TaskProjGroup(TechDraw::DrawView* featView, bool mode);
+        // Android-port note: declared rather than defaulted. The Ui_TaskProjGroup type is only
+    // forward-declared in this header, and the NDK's libc++ rejects a defaulted
+    // destructor for a unique_ptr member of incomplete type
+    //   (static_assert: cannot delete an incomplete type).
+    // The definition lives in the .cpp, which includes ui_TaskProjGroup.h.
+    ~TaskProjGroup() override;
+
+    virtual bool accept();
+    virtual bool reject();
+    virtual bool apply();
