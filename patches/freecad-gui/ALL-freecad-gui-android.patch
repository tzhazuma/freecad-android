-#else
-    const char* _f = std::strstr(file, "/src/");
-#endif
-    str << "## " << (_f ? _f + 5 : file) << '(' << line << ')';
-    Gui::Application::Instance->macroManager()->addLine(MacroManager::Cmt, str.str().c_str());
