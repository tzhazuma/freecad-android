diff --git a/CMakeLists.txt b/CMakeLists.txt
index bfd4cfb..88803a9 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -261,6 +261,36 @@ else()
     list(APPEND COIN_TARGET_INCLUDE_DIRECTORIES ${X11_INCLUDE_DIR})
     list(APPEND COIN_TARGET_LINK_LIBRARIES ${X11_LIBRARIES})
   endif()
+  # Android-port: Android ships OpenGL ES (libGLESv2), never desktop OpenGL, so
+  # find_package(OpenGL REQUIRED) cannot succeed and OPENGL_gl_LIBRARY has no meaning.
+  # Point Coin's dynamic loader at libGLESv2.so instead, and treat GLES as the GL
+  # implementation. Note this only makes configure succeed; the renderer still needs a
+  # GLES-safe draw path (immediate mode is absent from GLES).
+  if(ANDROID)
+    set(HAVE_OPENGL 1)
+    set(HAVE_GLES 1)
+    set(OPENGL_SYSTEM_LIBRARY_NAME "libGLESv2.so")
+    set(OPENGL_INCLUDE_DIR "${CMAKE_ANDROID_NDK}/toolchains/llvm/prebuilt/${ANDROID_HOST_TAG}/sysroot/usr/include")
+    # gl4es (prefix/arm64-v8a/lib/libGL.so) implements the desktop-GL 1.5 entry
+    # points that Coin's fixed-function renderer calls (glLightf, immediate mode,
+    # ...) and forwards them to GLES at runtime. Without it the link fails with
+    # "undefined symbol: glLightf". GLU comes from GLU-master in the same prefix.
+    # Use the full paths from find_package(OpenGL): a bare -lGL/-lGLU is not
+    # findable because the prefix lib dir is not on the link search path.
+    if(OPENGL_gl_LIBRARY)
+      list(APPEND COIN_TARGET_LINK_LIBRARIES_GL ${OPENGL_gl_LIBRARY})
+    else()
+      list(APPEND COIN_TARGET_LINK_LIBRARIES_GL GL)
+    endif()
+    if(OPENGL_glu_LIBRARY)
+      list(APPEND COIN_TARGET_LINK_LIBRARIES_GL ${OPENGL_glu_LIBRARY})
+      set(HAVE_GLU 1)
+    endif()
+    if(COIN_BUILD_EGL)
+      set(HAVE_EGL 1)
+      list(APPEND COIN_TARGET_LINK_LIBRARIES_GL GLESv2 EGL)
+    endif()
+  else()
   find_package(OpenGL REQUIRED)
   if(OPENGL_FOUND)
     set(HAVE_OPENGL 1)
@@ -296,6 +326,7 @@ else()
       endif()
     endif()
   endif()
+  endif()   # ANDROID branch
 endif()
 
 list(APPEND COIN_TARGET_LINK_LIBRARIES ${COIN_TARGET_LINK_LIBRARIES_GL})
