# Build trees
build/

# Qt for Android installation (multi-GB)
/Qt/

# Downloaded source tarballs / third-party archives
/dl/

# Android build outputs and packaged binaries
*.apk
*.aab

# Prebuilt native libraries (cross-compiled, not source)
**/jniLibs/**/*.so
# Any other prebuilt native object shipped in the APK
**/*.so

# Gradle
.gradle/
local.properties

# Logs
*.log

# Scratch screenshots (keep the committed PNGs)
screenshots/*.tmp

# macOS
.DS_Store

# Python virtualenvs used for build tooling
.venv/
.venv312/

# Cross-compiled install prefix (NDK artifacts, multi-GB)
/prefix/

# Extracted third-party sources (OCCT, boost, gl4es, cpython, GLU)
/src/

# Assembled runtime bundle for packaging
/runtime-bundle/

# Stale backup archives
/backup/

# aqtinstall / Qt installer logs and caches
aqtinstall.log

# Python standard library payload for the APK: a reproducible build artifact
# (cross-compiled from src/cpython-3.11.9 into prefix/py311-arm64-v8a and copied
# here by scripts/configure-freecad-gui-qt683.sh). ~176 MB, and it made the
# 168 MB pack unpushable over a slow link. The shipped APK on the Releases page
# carries it; a fresh clone rebuilds it from source.
android-app/app/src/main/assets/pylib/

# Packaged native libraries for the APK: build artifacts copied in by the build
# scripts (and by the jniLibs swap step). The `**/*.so` rule above already covers
# most of them, but versioned names such as libpython3.11.so.1.0 slipped through
# and added 19 MB to the commit.
android-app/jniLibs/
